# Copie para .env.local e preencha. Nunca versione valores reais.

# URL do projeto Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable/anon). Segura para o navegador — a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública da aplicação (usada em links de e-mail e convites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: CAPTCHA Cloudflare Turnstile no cadastro e recuperação de senha.
# A chave secreta é configurada no painel do Supabase (Auth > Bot protection), não aqui.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
